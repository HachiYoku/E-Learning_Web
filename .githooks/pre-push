#!/usr/bin/env bash
set -euo pipefail
repo=$(git rev-parse --show-toplevel)
remote_name=${1:-}
remote_url=${2:-}
zero=0000000000000000000000000000000000000000
[[ -n "$remote_name" && -n "$remote_url" ]] || { echo "Missing push destination; push blocked." >&2; exit 1; }

configured=$(git remote get-url --push "$remote_name" 2>/dev/null) || configured=
[[ "$configured" == "$remote_url" || ( -z "$configured" && "$remote_name" == "$remote_url" ) ]] || {
  echo "Ambiguous push destination; push blocked." >&2
  exit 1
}

updates=0
while read -r local_ref local_sha remote_ref remote_sha; do
  updates=$((updates + 1))
  [[ "$remote_ref" == refs/heads/* && "$remote_sha" =~ ^[0-9a-f]{40}$
    && "$local_sha" =~ ^[0-9a-f]{40}$ ]] || {
    echo "Unsupported or ambiguous push ref; push blocked." >&2
    exit 1
  }
  [[ "$local_sha" != "$zero" ]] || continue # Deleting a ref introduces no commits.

  actual=$(git ls-remote "$remote_url" "$remote_ref" 2>/dev/null) || {
    echo "Cannot verify push destination; push blocked." >&2
    exit 1
  }
  if [[ "$remote_sha" != "$zero" ]]; then
    [[ "$actual" == "$remote_sha"$'\t'"$remote_ref" ]] || {
      echo "Remote changed since push negotiation; push blocked." >&2
      exit 1
    }
    base=$remote_sha
  else
    [[ -z "$actual" ]] || { echo "New branch already exists; push blocked." >&2; exit 1; }
    # A new branch has no old SHA. Use only an ancestor independently verified
    # as an existing branch on this same destination remote.
    heads=$(git ls-remote --heads "$remote_url" 2>/dev/null) || {
      echo "Cannot establish destination baseline; push blocked." >&2
      exit 1
    }
    base=
    while read -r candidate candidate_ref; do
      [[ "$candidate" =~ ^[0-9a-f]{40}$ && "$candidate_ref" == refs/heads/* ]] || continue
      git cat-file -e "${candidate}^{commit}" 2>/dev/null || continue
      git merge-base --is-ancestor "$candidate" "$local_sha" || continue
      if [[ -z "$base" ]] || git merge-base --is-ancestor "$base" "$candidate"; then base=$candidate; fi
    done <<< "$heads"
    [[ -n "$base" ]] || { echo "No verified ancestor on destination remote; push blocked." >&2; exit 1; }
  fi
  "$repo/scripts/secret-scan.sh" range "$base" "$local_sha"
done
[[ "$updates" -gt 0 ]] || { echo "No push updates supplied; push blocked." >&2; exit 1; }
