NODE_ENV=production
PORT=3000
MONGO_DB=your_mongodb_connection_string
STANDALONE_QUIZ_EXPECTED_DB=your_expected_database_name
JWT_SECRET=generate_a_long_random_secret


ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=English Kafe <no-reply@example.com>
ADMIN_PAYMENT_NOTIFICATION_EMAIL=payment-review@example.com

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Required for question-media uploads and automatic cleanup. Set explicitly to testing or production.
QUIZ_QUESTION_MEDIA_ENV=testing_or_production

BACKEND_URL=https://api.example.com
FRONTEND_URL_PROD=https://www.example.com
ADMIN_URL_PROD=https://admin.example.com

TRUST_PROXY=true
TURNSTILE_SECRET_KEY=your_private_turnstile_secret_key
TURNSTILE_ALLOWED_HOSTNAMES=example.com
